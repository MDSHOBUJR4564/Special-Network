{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Administrator user profile",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Customer and system user profile",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "packageName": { "type": "string" },
        "price": { "type": "number" },
        "status": { "type": "string" },
        "role": { "type": "string" },
        "expiryDate": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["username", "fullName", "role"]
    },
    "Package": {
      "title": "Package",
      "description": "ISP internet package speed and pool definitions",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "localAddress": { "type": "string" },
        "remoteAddress": { "type": "string" },
        "rateLimit": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "price", "rateLimit"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Billing invoices for internet service subscriptions",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "amount": { "type": "number" },
        "month": { "type": "string" },
        "status": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "transactionId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "amount", "month", "status"]
    },
    "Ticket": {
      "title": "Ticket",
      "description": "Customer support and complaint ticket",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "subject", "message", "status"]
    },
    "Setting": {
      "title": "Setting",
      "description": "System settings such as MikroTik, bKash, and SMS configurations",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["key", "value"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Authorized administrators collection"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Customers and operators profiles"
    },
    "/packages/{packageId}": {
      "schema": "Package",
      "description": "Internet bandwidth and IP pool packages"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Customer invoices and payment records"
    },
    "/tickets/{ticketId}": {
      "schema": "Ticket",
      "description": "Support tickets raised by customers or admin"
    },
    "/settings/{settingKey}": {
      "schema": "Setting",
      "description": "System configurations and integrations"
    }
  }
}
